meta {
  name: Password Reset Email
  type: http
  seq: 2
}

post {
  url: {{kafkaUiUrl}}/api/clusters/{{kafkaCluster}}/topics/password-reset/messages
  body: json
  auth: none
}

body:json {
  {
    "partition": 0,
    "keySerde": "String",
    "valueSerde": "String",
    "value": "{\"to\":\"{{recipient}}\",\"from\":\"{{sender}}\",\"subject\":\"Reset your password\",\"body\":\"Use this link to reset your password. It expires in 30 minutes: http://localhost:3000/reset-password?token=bruno-sample\"}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Publishes what UserAuthService sends on forgot-password to the `password-reset` topic. The token is a sample, not a working one.
}
