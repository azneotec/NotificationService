# Copy to .env (gitignored) and adjust. Read by `./mvnw spring-boot:run` and `java -jar`.
# Unquoted values only. Anything also set as a real environment variable takes precedence.

# App password of the Gmail account that sends the mail (the sender address comes from each Kafka message).
GMAIL_PASSWORD=your_gmail_app_password

# Registers with Eureka (http://localhost:8761) so the service shows up beside the others. Set to false for a
# standalone run; nothing calls NotificationService over HTTP, it only consumes Kafka.
EUREKA_CLIENT_ENABLED=true

# Optional. The app listens on 8006 by default; set 9006 to run a second instance beside it.
#SERVER_PORT=9006
